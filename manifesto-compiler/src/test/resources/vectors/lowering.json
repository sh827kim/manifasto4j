  {
    "testName": "lowerExprNode: call eq",
    "input": {
      "kind": "call",
      "fn": "eq",
      "args": [
        {
          "kind": "get",
          "path": [
            {
              "kind": "prop",
              "name": "x"
            }
          ]
        },
        {
          "kind": "lit",
          "value": 5
        }
      ]
    },
    "expected": {
      "kind": "eq",
      "left": {
        "kind": "get",
        "path": "x"
      },
      "right": {
        "kind": "lit",
        "value": 5
      }
    }
  },
  {
    "testName": "lowerExprNode: call not",
    "input": {
      "kind": "call",
      "fn": "not",
      "args": [
        {
          "kind": "lit",
          "value": true
        }
      ]
    },
    "expected": {
      "kind": "not",
      "arg": {
        "kind": "lit",
        "value": true
      }
    }
  },
  {
    "testName": "lowerExprNode: call and",
    "input": {
      "kind": "call",
      "fn": "and",
      "args": [
        {
          "kind": "lit",
          "value": true
        },
        {
          "kind": "lit",
          "value": false
        }
      ]
    },
    "expected": {
      "kind": "and",
      "args": [
        {
          "kind": "lit",
          "value": true
        },
        {
          "kind": "lit",
          "value": false
        }
      ]
    }
  },
  {
    "testName": "lowerExprNode: call if",
    "input": {
      "kind": "call",
      "fn": "if",
      "args": [
        {
          "kind": "lit",
          "value": true
        },
        {
          "kind": "lit",
          "value": 1
        },
        {
          "kind": "lit",
          "value": 0
        }
      ]
    },
    "expected": {
      "kind": "if",
      "cond": {
        "kind": "lit",
        "value": true
      },
      "then": {
        "kind": "lit",
        "value": 1
      },
      "else": {
        "kind": "lit",
        "value": 0
      }
    }
  },
  {
    "testName": "lowerExprNode: call filter",
    "input": {
      "kind": "call",
      "fn": "filter",
      "args": [
        {
          "kind": "get",
          "path": [
            {
              "kind": "prop",
              "name": "items"
            }
          ]
        },
        {
          "kind": "call",
          "fn": "gt",
          "args": [
            {
              "kind": "var",
              "name": "item"
            },
            {
              "kind": "lit",
              "value": 0
            }
          ]
        }
      ]
    },
    "expected": {
      "kind": "filter",
      "array": {
        "kind": "get",
        "path": "items"
      },
      "predicate": {
        "kind": "gt",
        "left": {
          "kind": "get",
          "path": "$item"
        },
        "right": {
          "kind": "lit",
          "value": 0
        }
      }
    }
  },
  {
    "testName": "lowerExprNode: obj",
