            "value": 2
          }
        }
      ]
    },
    "expected": {
      "kind": "object",
      "fields": {
        "x": {
          "kind": "lit",
          "value": 1
        },
        "y": {
          "kind": "lit",
          "value": 2
        }
      }
    }
  },
  {
    "testName": "lowerExprNode: arr literals",
    "input": {
      "kind": "arr",
      "elements": [
