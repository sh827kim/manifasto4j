      ]
    }
  },
  {
    "testName": "lowerExprNode: arr mixed",
    "input": {
      "kind": "arr",
      "elements": [
        {
          "kind": "lit",
          "value": 1
        },
        {
          "kind": "get",
          "path": [
            {
              "kind": "prop",
              "name": "x"
            }
          ]
        }
      ]
    },
    "expected": {
      "kind": "append",
      "array": {
        "kind": "lit",
        "value": []
      },
      "items": [
        {
          "kind": "lit",
          "value": 1
        },
        {
          "kind": "get",
          "path": "x"
        }
      ]
    }
  },
  {
    "testName": "lowerExprNode: arr empty",
    "input": {
      "kind": "arr",
      "elements": []
    },
    "expected": {
